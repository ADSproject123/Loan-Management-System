*.pfx

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# env files (never commit secrets; keep .env.example as the template)
.env
.env.*
.env*
!.env.example

# vercel / deployment
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases / dumps
*.sqlite
*.sqlite3
*.db

# IDE / editor
.cursor/
.vscode/
.idea/
*.swp
*.swo
*~

# AI / local dev tooling (machine-specific)
.claude/
.qodo/
.superpowers/
docs/superpowers/

# python (used by .cursor skills)
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/

# supabase local CLI
supabase/.temp/
supabase/.branches
supabase/.env
supabase/.env.*

# local uploads / scratch (if ever used on disk)
uploads/
tmp/
temp/
.cache/
